# Dependencies: nothing is installed in this repository
node_modules/

# Output of test runs of the hand-in program (MAKEFUN_OUTPUT_DIR) and other build output
/out/
out/
/output/

# Secrets: never commit an environment file or a wallet keypair
.env
.env.*
*keypair*.json
id.json

# Archives and bundles
*.tar.gz
*.tgz
*.bundle

# Blender and Python leftovers of the art pipeline
__pycache__/
*.pyc
*.blend1

# Editor and operating-system junk
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/

# Logs and scratch (scratch belongs under /tmp/marazul/, not here)
*.log
/tmp/

# Whatever a rule above says, everything the game ships is tracked
!/game/assets/**
!/game/vendor/**
